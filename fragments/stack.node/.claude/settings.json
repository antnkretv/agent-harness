{
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"command": "\"$CLAUDE_PROJECT_DIR/.harness/hooks/python.cmd\" \"$CLAUDE_PROJECT_DIR/.harness/ah.py\" hook eslint-file",
						"statusMessage": "ESLint по изменённому файлу…",
						"timeout": 120,
						"type": "command"
					}
				]
			}
		]
	}
}
