{
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"command": "bash \"$CLAUDE_PROJECT_DIR/.harness/hooks/eslint-file.sh\"",
						"shell": "bash",
						"statusMessage": "ESLint по изменённому файлу…",
						"timeout": 120,
						"type": "command"
					}
				]
			}
		]
	}
}
