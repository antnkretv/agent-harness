{
	"hooks": {
		"PreToolUse": [
			{
				"hooks": [
					{
						"command": "\"$CLAUDE_PROJECT_DIR/.harness/hooks/python.cmd\" \"$CLAUDE_PROJECT_DIR/.harness/ah.py\" hook code-cleanup",
						"if": "Bash(git commit:*)",
						"statusMessage": "Code Cleanup: dotnet format по solution, CSharpier по дереву…",
						"timeout": 600,
						"type": "command"
					}
				],
				"matcher": "Bash"
			}
		]
	}
}
