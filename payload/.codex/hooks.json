{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./.harness/hooks/python.cmd .harness/ah.py hook --fetch agent-gate codex prompt",
            "timeout": 900
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./.harness/hooks/python.cmd .harness/ah.py hook agent-gate codex tool",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./.harness/hooks/python.cmd .harness/ah.py hook agent-gate codex stop",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
