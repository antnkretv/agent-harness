{
	"permissions": {
		"allow": [
			"Bash(git push --force-with-lease*)",
			"Bash(git push * --force-with-lease*)"
		],
		"deny": [
			"Read(./.harness/settings.env)"
		]
	},
	"hooks": {
		"SessionStart": [
			{
				"matcher": "startup|resume",
				"hooks": [
					{
						"command": "\"$CLAUDE_PROJECT_DIR/.harness/hooks/python.cmd\" \"$CLAUDE_PROJECT_DIR/.harness/ah.py\" hook session-start claude",
						"statusMessage": "Настройка окружения (toolchain из манифеста проекта)...",
						"timeout": 900,
						"type": "command"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"command": "\"$CLAUDE_PROJECT_DIR/.harness/hooks/python.cmd\" \"$CLAUDE_PROJECT_DIR/.harness/ah.py\" hook comments-file",
						"statusMessage": "Слой комментариев по изменённому файлу…",
						"timeout": 120,
						"type": "command"
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"command": "\"$CLAUDE_PROJECT_DIR/.harness/hooks/python.cmd\" \"$CLAUDE_PROJECT_DIR/.harness/ah.py\" hook agent-gate claude prompt",
						"timeout": 60,
						"type": "command"
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
				"hooks": [
					{
						"command": "\"$CLAUDE_PROJECT_DIR/.harness/hooks/python.cmd\" \"$CLAUDE_PROJECT_DIR/.harness/ah.py\" hook agent-gate claude tool",
						"timeout": 60,
						"type": "command"
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"command": "\"$CLAUDE_PROJECT_DIR/.harness/hooks/python.cmd\" \"$CLAUDE_PROJECT_DIR/.harness/ah.py\" hook agent-gate claude stop",
						"statusMessage": "Конвейер разработки: следующий шаг…",
						"timeout": 180,
						"type": "command"
					}
				]
			}
		]
	}
}
