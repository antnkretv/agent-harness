{
  "modules": [
    {
      "id": "secret-scan",
      "enabled": true,
      "title": "Секреты не попадают в дерево и историю ветки",
      "doc": "docs/platform/delivery/ci-cd.md",
      "gate": ".gitleaks.toml"
    },
    {
      "id": "diagnostic-integrity",
      "enabled": true,
      "title": "Диагностика исправляется без ручного подавления",
      "doc": "docs/platform/architecture/gates.md#целостность-диагностики",
      "gate": ".harness/scripts/check/check-diagnostic-integrity.py"
    },
    {
      "id": "commit-format",
      "enabled": true,
      "title": "Conventional Commits, правила письма и объем сообщения коммита",
      "doc": "CONTRIBUTING.md",
      "gate": ".harness/scripts/check/check-commits.py"
    },
    {
      "id": "findings-in-pr",
      "enabled": true,
      "title": "Попутная находка идет по политике agents.findings; при same-pr текст у поставщика кода не объявляет ее отложенной",
      "doc": "CONTRIBUTING.md",
      "gate": ".harness/hooks/forge-text-lint.py"
    },
    {
      "id": "agent-signature",
      "enabled": true,
      "title": "Комментарий агента у поставщика кода несет подпись из authorship",
      "doc": "docs/platform/delivery/ci-cd.md",
      "gate": ".harness/hooks/forge-text-lint.py"
    },
    {
      "id": "prose",
      "enabled": true,
      "title": "Правила письма человеческого текста",
      "doc": "docs/platform/standards/text.md",
      "gate": ".harness/scripts/check/vale-lint.py",
      "inputs": [
        ".vale.ini",
        ".vale/",
        ".harness/scripts/check/comment_scan.py",
        ".harness/scripts/text/code_text.py",
        ".harness/scripts/text/text_primitives.py",
        ".harness/scripts/ci_common.py",
        ".harness/lib/manifest.py",
        ".harness/project/manifest.json"
      ]
    },
    {
      "id": "comment-layer",
      "enabled": true,
      "title": "Слой комментариев в коде",
      "doc": "docs/platform/standards/code-comments.md",
      "gate": ".harness/scripts/check/check-comments.py"
    },
    {
      "id": "harness-files",
      "enabled": true,
      "title": "Файл комплекта правится в комплекте, а проект держит свое в местах проекта",
      "doc": "docs/platform/agents/harness.md#роли-файлов",
      "gate": ".harness/scripts/check/check-harness-files.py"
    },
    {
      "id": "text-registry",
      "enabled": true,
      "title": "Текст для людей живет в реестре своего корня",
      "doc": "docs/platform/architecture/gates.md#реестры-текста",
      "gate": ".harness/scripts/check/check-text-registry.py"
    },
    {
      "id": "adr-reference",
      "enabled": true,
      "title": "Ссылка на решение несет область",
      "doc": "docs/platform/adr/README.md",
      "gate": ".harness/scripts/check/check-adr-refs.py"
    },
    {
      "id": "tool-pins",
      "enabled": true,
      "title": "Версии тулчейна и пакетов живут в машинных манифестах, чужая оснастка агентов закреплена digest",
      "doc": "docs/platform/agents/environment.md",
      "gate": ".harness/scripts/check/check-tool-pins.py"
    },
    {
      "id": "requirements-registry",
      "enabled": true,
      "title": "Запись реестра требований открыта, когда правится ее свидетельство",
      "doc": "docs/platform/delivery/sdd.md#трассируемость-fr-nnn",
      "gate": ".harness/scripts/check/check-requirements-registry.py"
    },
    {
      "id": "docs-structure",
      "enabled": true,
      "title": "Ссылки, инструкции агентов и соглашения документов проекта",
      "doc": "docs/platform/standards/root-entry-docs.md",
      "gate": ".harness/scripts/check/check-docs.py"
    },
    {
      "id": "doc-symbols",
      "enabled": true,
      "title": "Имена из документов фич существуют в коде",
      "doc": "docs/platform/standards/documentation.md",
      "gate": ".harness/scripts/check/check-doc-symbols.py"
    },
    {
      "id": "test-usefulness",
      "enabled": true,
      "title": "Бюджет и критерий полезности теста",
      "doc": "docs/platform/standards/test-usefulness.md",
      "gate": ".harness/scripts/check/check-test-budget.py"
    },
    {
      "id": "shell-scripts",
      "enabled": true,
      "title": "Скрипты проходят синтаксис и shellcheck",
      "doc": "docs/platform/delivery/ci-cd.md",
      "gate": ".harness/scripts/check/check-shell.sh"
    },
    {
      "id": "area-profiles",
      "enabled": true,
      "title": "Единые точки входа проверок приложений",
      "doc": "CONTRIBUTING.md",
      "gate": ".harness/scripts/check/check-area-profiles.py"
    },
    {
      "id": "sdd",
      "module": "sdd/speckit",
      "enabled": true,
      "title": "Конвейер Spec Kit",
      "doc": "docs/platform/delivery/sdd.md",
      "gate": null
    },
    {
      "id": "sdd-market",
      "module": "sdd/speckit",
      "enabled": true,
      "title": "Рыночная сверка спеки перед clarify",
      "doc": ".agents/skills/speckit-market/SKILL.md",
      "gate": null
    },
    {
      "id": "sdd-clarify",
      "module": "sdd/speckit",
      "enabled": true,
      "title": "Уточнение дыр в спеке без потолка вопросов",
      "doc": ".agents/skills/speckit-clarify/SKILL.md",
      "gate": null
    },
    {
      "id": "issue-pipeline",
      "module": "core",
      "enabled": true,
      "title": "Разработка через issues",
      "doc": ".agents/skills/issue-dev/SKILL.md",
      "gate": null
    },
    {
      "id": "simplify",
      "module": "core",
      "enabled": true,
      "title": "Упрощение диффа перед кругом ревью",
      "doc": ".agents/skills/code-simplifier/SKILL.md",
      "gate": null
    },
    {
      "id": "pre-draft-audit",
      "module": "core",
      "enabled": true,
      "title": "Повторный аудит текстов и спецификаций перед Draft PR",
      "doc": ".harness/prompts/stage/pre-draft-audit.md",
      "gate": null
    },
    {
      "id": "pipeline",
      "enabled": true,
      "title": "Конвейер и проходы ревью объявлены манифестом",
      "doc": ".harness/README.md",
      "gate": ".harness/scripts/check/check-pipeline.py",
      "copies": [
        ".agents/skills/issue-dev/SKILL.md",
        ".agents/skills/review/SKILL.md",
        ".agents/skills/code-simplifier/SKILL.md",
        ".agents/skills/README.md",
        "AGENTS.md",
        "CLAUDE.md",
        "CONTRIBUTING.md",
        "REVIEW.md",
        "docs/platform/delivery/*.md",
        "docs/platform/agents/*.md",
        "docs/platform/operations/*.md",
        ".harness/README.md",
        ".harness/prompts/*/*.md",
        ".harness/templates/change/request.md",
        ".github/pull_request_template.md",
        ".gitlab/merge_request_templates/*.md",
        ".codex/agents/*.toml",
        ".harness/scripts/messages.env",
        ".harness/scripts/*.py",
        ".harness/scripts/*/*.py",
        ".harness/lib/*.py",
        "README.md"
      ]
    },
    {
      "id": "agent-permissions",
      "enabled": true,
      "title": "Запреты действий агента объявлены манифестом, а не схемой исполнителя",
      "doc": ".harness/README.md",
      "gate": ".harness/scripts/check/check-agent-permissions.py"
    },
    {
      "id": "code-review",
      "module": "review",
      "enabled": true,
      "title": "Ревью кода",
      "doc": ".agents/skills/review/SKILL.md",
      "gate": null
    },
    {
      "id": "release-session",
      "module": "release/tag-flow",
      "enabled": true,
      "title": "Сессия релиза от среза до итога выката",
      "doc": ".agents/skills/release/SKILL.md",
      "gate": null
    },
    {
      "id": "architecture-review",
      "module": "core",
      "enabled": true,
      "title": "Сценарное архитектурное ревью",
      "doc": ".agents/skills/architecture-review/SKILL.md",
      "gate": null
    },
    {
      "id": "workflow-shell",
      "enabled": true,
      "title": "Поиск без совпадения не роняет шаг конвейера",
      "doc": "docs/platform/delivery/ci-cd.md",
      "gate": ".harness/scripts/check/check-workflow-shell.py"
    },
    {
      "id": "workflow-names",
      "enabled": true,
      "title": "Одно действие конвейера - одно написание имени шага",
      "doc": "docs/platform/delivery/ci-cd.md",
      "gate": ".harness/scripts/check/check-workflow-names.py"
    },
    {
      "id": "review-label",
      "enabled": true,
      "title": "Несостоявшийся круг ревью виден на PR",
      "doc": "docs/platform/delivery/ci-cd.md",
      "gate": ".harness/scripts/check/check-review-label.py"
    },
    {
      "id": "pr-issue-link",
      "enabled": true,
      "title": "Ветка задачи связана с ней в теле PR",
      "doc": "CONTRIBUTING.md",
      "gate": ".harness/scripts/check/check-pr-issue-link.py"
    },
    {
      "id": "pr-size",
      "enabled": true,
      "title": "Размер PR в пределе policies.size или причина превышения в теле PR",
      "doc": "CONTRIBUTING.md#3-pull-requests",
      "gate": ".harness/scripts/check/check-pr-size.py"
    },
    {
      "id": "architecture-node",
      "enabled": true,
      "title": "Границы слоев приложения держит ESLint",
      "doc": "docs/platform/architecture/gates.md",
      "gate": ".config/eslint-boundaries.js"
    },
    {
      "id": "node-adapter",
      "enabled": true,
      "title": "ESLint каждого приложения node подключает адаптер комплекта",
      "doc": "docs/platform/architecture/gates.md",
      "gate": ".harness/scripts/check/check-node-adapter.py"
    },
    {
      "id": "build-diagnostics",
      "enabled": true,
      "title": "Сборка .NET без ошибок, предупреждений и сообщений",
      "doc": "docs/platform/delivery/ci-cd.md",
      "gate": ".harness/scripts/check/check-build-diagnostics.py"
    },
    {
      "id": "dotnet-format",
      "enabled": true,
      "title": "Файлы C# совпадают с выводом CSharpier",
      "doc": "docs/platform/delivery/ci-cd.md",
      "gate": ".harness/scripts/check/check-dotnet-format.py"
    },
    {
      "id": "docs-text",
      "module": "core",
      "enabled": true,
      "title": "Вычитка текста по общему стандарту",
      "doc": ".agents/skills/docs-text/SKILL.md",
      "gate": null
    },
    {
      "id": "code-docs",
      "module": "core",
      "enabled": true,
      "title": "Документирующие комментарии по контракту и границам",
      "doc": ".agents/skills/code-docs/SKILL.md",
      "gate": null
    },
    {
      "id": "log-inventory",
      "module": "core",
      "enabled": true,
      "title": "Инвентаризация реестров сообщений по группам необходимости и уровню",
      "doc": ".agents/skills/log-inventory/SKILL.md",
      "gate": null
    }
  ],
  "processes": {
    "develop": {
      "title": "Разработка задачи",
      "doc": ".agents/skills/issue-dev/SKILL.md",
      "audit": true,
      "steps": [
        {
          "id": "claim",
          "title": "Взятие задачи и ветка",
          "actor": "agent",
          "doc": ".agents/skills/issue-dev/SKILL.md#claim",
          "requires": [],
          "produces": [
            "assignee",
            "branch"
          ],
          "gates": []
        },
        {
          "id": "clarify",
          "title": "Уточнение постановки",
          "actor": "agent",
          "session": true,
          "doc": ".agents/skills/issue-dev/SKILL.md#clarify",
          "requires": [
            "claim"
          ],
          "produces": [
            "clarified"
          ],
          "gates": []
        },
        {
          "id": "sync-base",
          "title": "Подлить базовую ветку",
          "actor": "agent",
          "doc": ".agents/skills/issue-dev/SKILL.md#sync-base",
          "requires": [
            "clarify"
          ],
          "produces": [
            "merged-base"
          ],
          "gates": []
        },
        {
          "id": "implement",
          "title": "Цельная реализация и первый commit",
          "actor": "agent",
          "doc": ".agents/skills/issue-dev/SKILL.md#implement",
          "requires": [
            "sync-base"
          ],
          "produces": [
            "commits"
          ],
          "gates": [
            ".harness/scripts/check/check-commits.py"
          ]
        },
        {
          "ref": "verification/test-audit",
          "requires": [
            "implement"
          ]
        },
        {
          "ref": "verification/finding-audit"
        },
        {
          "ref": "verification/pre-draft-audit"
        }
      ],
      "runner": "issue-agent",
      "auditRunner": "review-requirements"
    },
    "simplification": {
      "title": "Упрощение изменений",
      "doc": ".agents/skills/code-simplifier/SKILL.md",
      "audit": true,
      "steps": [
        {
          "id": "simplify",
          "title": "Упрощение перед каждым кругом ревью",
          "actor": "agent",
          "doc": ".agents/skills/issue-dev/SKILL.md#simplify",
          "requires": [],
          "produces": [
            "simplify-pass"
          ],
          "gates": [],
          "scope": "round"
        },
        {
          "id": "checkpoint",
          "title": "Зафиксировать упрощение",
          "actor": "agent",
          "doc": ".agents/skills/issue-dev/SKILL.md#checkpoint",
          "requires": [
            "simplify"
          ],
          "produces": [
            "simplification-checkpoint"
          ],
          "gates": [
            ".harness/scripts/check/check-commits.py"
          ]
        }
      ],
      "runner": "issue-agent",
      "auditRunner": "review-requirements"
    },
    "verification": {
      "title": "Проверка текущего снимка",
      "doc": ".agents/skills/issue-dev/SKILL.md",
      "audit": true,
      "steps": [
        {
          "id": "test-audit",
          "title": "Аудит новых тестов",
          "actor": "agent",
          "doc": ".agents/skills/issue-dev/SKILL.md#test-audit",
          "requires": [],
          "produces": [
            "test-audit"
          ],
          "gates": []
        },
        {
          "id": "finding-audit",
          "title": "Аудит находок перед каждым кругом",
          "actor": "agent",
          "doc": ".agents/skills/issue-dev/SKILL.md#finding-audit",
          "requires": [
            "test-audit"
          ],
          "produces": [
            "finding-audit"
          ],
          "gates": []
        },
        {
          "id": "pre-draft-audit",
          "title": "Повторный аудит текстов и спецификаций",
          "actor": "agent",
          "doc": ".agents/skills/issue-dev/SKILL.md#pre-draft-audit",
          "prompt": "pre-draft-audit",
          "requires": [
            "finding-audit"
          ],
          "produces": [
            "text-spec-audit"
          ],
          "gates": []
        }
      ],
      "runner": "issue-agent",
      "auditRunner": "review-requirements"
    },
    "final-gates": {
      "title": "Финальные гейты перед Ready",
      "doc": ".agents/skills/issue-dev/SKILL.md#gates",
      "steps": [
        {
          "id": "gates",
          "title": "Полный check-all один раз после апрува всех проходов",
          "actor": "command",
          "doc": ".agents/skills/issue-dev/SKILL.md#gates",
          "requires": [],
          "produces": [
            "verified-head"
          ],
          "gates": [],
          "command": [
            "python3",
            ".harness/scripts/check/check-all.py"
          ]
        }
      ],
      "runner": "issue-agent",
      "auditRunner": "review-requirements"
    },
    "draft-pr": {
      "title": "Черновой PR после аудитов",
      "doc": ".agents/skills/issue-dev/SKILL.md#draft-pr",
      "steps": [
        {
          "id": "draft-pr",
          "title": "Черновой PR после аудитов",
          "actor": "agent",
          "doc": ".agents/skills/issue-dev/SKILL.md#draft-pr",
          "requires": [],
          "produces": [
            "pushed-head",
            "draft-pr"
          ],
          "gates": [
            ".harness/scripts/check/check-all.py",
            ".harness/scripts/check/check-pr-issue-link.py"
          ]
        }
      ],
      "runner": "issue-agent",
      "auditRunner": "review-requirements"
    },
    "review": {
      "doc": "docs/platform/delivery/ci-cd.md",
      "workflow": "{{#if module:forge/gitlab}}.gitlab/ci/review-round.yml{{else}}.github/workflows/code-review.yml{{/if}}",
      "commonPrompt": ".harness/prompts/review/common.md",
      "allowedTools": "Read,Grep,Glob,TodoWrite,Task",
      "disallowedTools": "Edit,Write,NotebookEdit,WebFetch,WebSearch,Bash(git push:*),Bash(git commit:*)",
      "label": "run-review",
      "failedLabel": "review-failed",
      "managedLabel": "agent-managed",
      "verdict": ".harness/scripts/review/review_verdict.py",
      "statusPrefix": "review",
      "_verdicts": [
        "Слово решения в маркере данных вердикта (строка Результат несет значок): его пишут",
        "публикатор и локальный круг, по нему маршрутизатор и воркфлоу находят решенное."
      ],
      "verdicts": {
        "approve": "апрув",
        "changes": "правки"
      },
      "stallRounds": 5,
      "decidedChars": 800,
      "contextChars": 6000,
      "bodyChars": 1500,
      "maps": {
        "entries": 200,
        "places": 3,
        "frequent": 30
      },
      "_machineTextExcept": [
        "Разница с docs.machineTextPrefixes, а не своя копия списка: тому specs/",
        "машинный текст, а разбору спека проза - коду в ней искать нечего."
      ],
      "_proseAlso": [
        "Прозой считается по имени, а не по расширению: указатель активного трека",
        "меняется раз в трек, разбирать в нем коду нечего."
      ],
      "proseAlso": [
        ".specify/feature.json"
      ],
      "_proseExcept": [
        "Шаблон публикуемого текста - часть кода публикатора: PR из одних шаблонов",
        "проходы кода и архитектуры не снимает. Vale проверяет его как текст."
      ],
      "proseExcept": [
        ".harness/templates/"
      ],
      "machineTextExcept": [
        "specs/"
      ],
      "fallback": {
        "doc": "docs/platform/delivery/ci-cd.md#локальный-круг-ревью",
        "runner": ".harness/scripts/review/review-local.py",
        "prompt": ".harness/prompts/review/local.md",
        "label": "review-local",
        "mark": "Локальный круг",
        "waitMinutes": 45,
        "pollMinutes": 5,
        "retries": 1,
        "timeoutMinutes": 30,
        "allowedTools": "Read,Grep,Glob,TodoWrite,Bash(git diff:*),Bash(git log:*),Bash(git show:*),Bash(git status:*)"
      },
      "steps": [
        {
          "id": "code",
          "title": "Ревью кода",
          "marker": "Ревью кода",
          "budget": 3,
          "job": "review",
          "threads": true,
          "prose": {
            "suffixes": [
              ".md",
              ".txt"
            ]
          },
          "doc": "REVIEW.md",
          "prompt": ".harness/prompts/review/code.md",
          "runner": "review-code",
          "context": true
        },
        {
          "id": "requirements",
          "title": "Ревью требований и документации",
          "marker": "Ревью требований",
          "budget": 2,
          "job": "review-requirements",
          "doc": ".harness/review/requirements.md",
          "prompt": ".harness/prompts/review/requirements.md",
          "context": true,
          "runner": "review-requirements"
        },
        {
          "id": "architecture",
          "title": "Ревью архитектуры",
          "marker": "Ревью архитектуры",
          "budget": 1,
          "job": "review-architecture",
          "prose": {
            "suffixes": [
              ".md",
              ".txt"
            ],
            "except": [
              "docs/platform/adr/",
              "AGENTS.md",
              "CLAUDE.md"
            ]
          },
          "doc": ".harness/review/architecture.md",
          "prompt": ".harness/prompts/review/architecture.md",
          "runner": "review-architecture",
          "context": true
        }
      ]
    },
    "merge": {
      "title": "Готовность, мерж и завершение задачи",
      "doc": ".agents/skills/issue-dev/SKILL.md",
      "steps": [
        {
          "id": "ready",
          "title": "Перевод в Ready",
          "actor": "agent",
          "doc": ".agents/skills/issue-dev/SKILL.md#ready",
          "requires": [],
          "produces": [
            "ready-pr"
          ],
          "gates": [],
          "readiness": [
            {
              "id": "approvals",
              "title": "У каждого обязательного прохода стоит успешный статус review/<проход> на текущей голове",
              "check": "pull_request_read:get_status"
            },
            {
              "id": "threads",
