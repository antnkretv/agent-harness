{
  "version": 1,
  "hooks": {
    "workspaceOpen": [
      {
        "command": "./.harness/hooks/python.cmd .harness/ah.py hook session-start cursor",
        "timeout": 60
      }
    ],
    "sessionStart": [
      {
        "command": "./.harness/hooks/python.cmd .harness/ah.py hook session-start cursor",
        "timeout": 900
      }
    ],
    "preToolUse": [
      {
        "command": "./.harness/hooks/python.cmd .harness/ah.py hook agent-deny cursor",
        "failClosed": true
      },
      {
        "command": "./.harness/hooks/python.cmd .harness/ah.py hook agent-gate cursor tool",
        "timeout": 60
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "./.harness/hooks/python.cmd .harness/ah.py hook agent-gate cursor prompt",
        "timeout": 60
      }
    ],
    "stop": [
      {
        "command": "./.harness/hooks/python.cmd .harness/ah.py hook agent-gate cursor stop",
        "timeout": 180,
        "loop_limit": 50
      }
    ]
  }
}
